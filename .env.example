# ==============================================================================
# AMD Developer Hackathon ACT III — Track 1: Intelligent Industry
# Autonomous Supply Chain Exception Handler & Command Center
# ==============================================================================

# --- AMD Hardware & Token Factory vLLM Configuration ---
# Live AMD Token Factory / vLLM OpenAI-compatible endpoint
AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=your_amd_token_factory_api_key_here
AMD_MODEL_NAME=Gemma-4-31B-IT
AMD_GPU_DEVICE=AMD Instinct MI300X (192GB HBM3, ROCm 6.3)

# Execution Modes:
# - auto: uses live AMD endpoint when AMD_API_KEY is provided, else falls back to deterministic replay
# - live: strictly requires AMD API endpoint
# - replay: runs deterministic heuristic golden engine (100% demo resilience during venue drops)
LLM_MODE=auto
SEND_MODE=simulated

# --- Multi-Criteria Sourcing Weights ---
WEIGHT_LEAD_TIME=0.40
WEIGHT_RELIABILITY=0.30
WEIGHT_PRICE=0.20
WEIGHT_CAPACITY=0.10

# --- Factory & Operations Cost Constants ---
CHANGEOVER_COST_USD=1500.0

# --- Database & Server Settings ---
DATABASE_PATH=backend/database/erp_sandbox.db
HOST=0.0.0.0
PORT=8000
DEBUG=false
